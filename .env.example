# ── Pream Configuration ──
# Copy this file to .env and customize

# Admin UI credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pream

# Output Xtream Codes API credentials (what IPTV clients connect with)
OUTPUT_USERNAME=pream
OUTPUT_PASSWORD=pream

# TMDB Metadata Enrichment (enable/disable, auto-group, API key, and request delay in seconds)
TMDB_ENABLED=true
TMDB_AUTO_GROUP=true
TMDB_API_KEY=abcdefghijklmnopqrstuvwxyz
TMDB_RATE_LIMIT=0.05

# Gemini AI Intelligent Title & Language Extraction (optional fallback)
GEMINI_ENABLED=true
GEMINI_API_KEY=
STAGGERED_GEMINI_CALLS=true
GEMINI_RATE_DELAY=4.0

# Telegram Notifications
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database (default: SQLite in ./data/)
DATABASE_URL=sqlite:///./data/pream.db

# Scheduler — automated source refresh schedule (cron expression)
REFRESH_CRON_ENABLED=true
REFRESH_CRON=0 4 * * *

# Global source-prefix grouping (true = prefix all groups with source name)
GROUP_BY_SOURCE=false

# Source scan threads (min: 1, max: 2) and network timeout (seconds)
SOURCE_SCAN_THREADS=1
SOURCE_TIMEOUT=60.0

# Stream health check & auto re-prioritization (max count: 5)
STREAM_HEALTH=true
STREAM_HEALTH_COUNT=4

# Stream failover & playback logging (zero-bandwidth transparent 302 redirect)
STREAM_FAILOVER=true
STREAM_HISTORY=true

# Server
HOST=0.0.0.0
PORT=8055
SERVER_NAME=Pream

# ── Container Resource Limits (Optional) ──
# Pream operates efficiently with modest hardware limits.
# Recommended: 1.5 - 2.0 CPUs, 1.5GB - 2.0GB RAM
PREAM_CPU_LIMIT=2.0
PREAM_MEMORY_LIMIT=2048M
PREAM_CPU_RESERVATION=0.5
PREAM_MEMORY_RESERVATION=512M
