# ── Pream Configuration ──
# Copy this file to .env and customize

# Admin UI credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pream

# Output Xtream Codes API credentials (what IPTV clients connect with)
OUTPUT_USERNAME=pream
OUTPUT_PASSWORD=pream

# TMDB Metadata Enrichment (enable/disable, auto-group, API key, and request delay in seconds)
TMDB_ENABLED=true
TMDB_AUTO_GROUP=true
TMDB_API_KEY=abcdefghijklmnopqrstuvwxyz
TMDB_RATE_LIMIT=0.05

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database (default: SQLite in ./data/)
DATABASE_URL=sqlite:///./data/pream.db

# Scheduler — cron expression for automatic source refresh
REFRESH_CRON=0 4 * * *

# Global source-prefix grouping (true = prefix all groups with source name)
GROUP_BY_SOURCE=false

# Source scan threads and network timeout (seconds)
SOURCE_SCAN_THREADS=2
SOURCE_TIMEOUT=60.0

# Stream health check & auto re-prioritization (max count: 5)
STREAM_HEALTH=true
STREAM_HEALTH_COUNT=4

# Stream failover & playback logging (zero-bandwidth transparent 302 redirect)
STREAM_FAILOVER=true
STREAM_HISTORY=true

# Server
HOST=0.0.0.0
PORT=8000
SERVER_NAME=Pream
